# Скопируйте в .env и заполните. Файл .env в git не попадает.
#
# Креды WebDAV. Пароль не хардкодится: приложение читает только эти переменные.
# Для реального сервера обязателен https:// — по http трафик и пароль идут открытым текстом.
WEBDAV_URL=https://dav.example.com/remote.php/dav/files/user/prompts
WEBDAV_USERNAME=user
WEBDAV_PASSWORD=secret

# Необязательные настройки:
# WEBDAV_VERIFY_SSL=true
# WEBDAV_TIMEOUT=30
#
# Переопределить каталог данных можно ТОЛЬКО переменной окружения процесса
# (PROMPTMANAGER_DATA). Значение из .env для неё не работает: .env читается
# уже после выбора каталога данных.
# PROMPTMANAGER_DATA=D:\Work\PromtMemory
